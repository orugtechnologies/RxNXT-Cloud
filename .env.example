DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret-key"

# Meta WhatsApp Cloud API (Official Enterprise Messaging)
META_WA_PHONE_NUMBER_ID="your_phone_number_id"
META_WA_ACCESS_TOKEN="your_permanent_system_user_access_token"
META_WA_BUSINESS_ACCOUNT_ID="your_waba_id"
META_GRAPH_API_VERSION="v19.0"
META_MESSAGES_PER_SECOND="20"
META_CONCURRENCY="10"

# Doctor Medical Council License Verification
DOCTOR_VERIFY_PROVIDER="apify" # options: "apify", "decentro", "surepass", "sandbox"
DOCTOR_VERIFY_API_KEY="your_apify_api_token"



